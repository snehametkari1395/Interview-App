# Copy to .streamlit/secrets.toml for local use, or paste into Streamlit Community Cloud
# (App settings -> Secrets). Never commit the real file.

OPENROUTER_API_KEY = "sk-or-v1-your-key"

# Optional. Defaults to openai/gpt-6-luna.
OPENROUTER_MODEL = "openai/gpt-6-luna"

# Optional. Used automatically if the primary model is unavailable.
# OPENROUTER_FALLBACK_MODEL = "anthropic/claude-sonnet-5.5"

# Optional. If set, visitors must enter this code before using the app,
# which protects your OpenRouter credits on a public deployment.
# APP_ACCESS_CODE = "choose-a-code"
